---
import "../styles/global.css";
---

<!-- Hero -->
<section class="bg-stone-700 bg-[url(../img/hero/top_1.webp)] bg-no-repeat bg-cover bg-blend-overlay flex flex-wrap flex-col relative w-full">
    <div class="justify-center items-center text-center p-25">
        <h1 class="font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">
            ¡Bienvenidos a Dos Carnes!
        </h1>
        <p class="font-poppins text-white text-lg md:text-2xl mb-8">
            Cada bocado es una celebración de nuestras raíces, y estamos <br /> 
            encantados de compartirlo contigo. ¡Siéntete como en casa y déjate llevar <br /> 
            por el sabor venezolano!<br /> 
            ¡Buen provecho!
        </p>
        <a href="/lacarta"><button class="font-poppins shadow-xl shadow-yellow-500/50 bg-black text-white hover:text-yellow-400 px-6 py-3 rounded-none border-yellow-400 border-4 font-medium text-2xl transition hover:-translate-y-1 hover:scale-110">
            Haz tu pedido
        </button></a>
    </div>
</section>