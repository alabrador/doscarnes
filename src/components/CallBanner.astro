---
import chat from "../img/logos/chat.svg"
import "../styles/global.css";
---

<section class="relative overflow-hidden bg-yellow-400 py-8 px-8">
    <div class="container">
        <div class="mx-4 flex flex-wrap items-center">
            <div class="w-full px-4 lg:w-1/2">
                <div class="text-center lg:text-left ">
                    <div class="mb-10 lg:mb-0 ">
                        <h1
                            class="font-pacifico mt-0 mb-3 text-2xl font-bold leading-tight sm:text-2xl sm:leading-tight md:text-[25px] md:leading-tight text-black ">
                            Disfruta el auténtico sabor Venezolano aquí</h1>
                        <p
                            class="w-full text-base font-medium leading-relaxed sm:text-lg sm:leading-relaxed text-white">
                        </p>
                    </div>
                </div>
            </div>
            <div class="mx-auto flex max-w-sm items-center gap-x-4 rounded-xl bg-white p-2 shadow-lg outline outline-black/5 dark:bg-slate-800 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10">
                <img class="size-12 shrink-0" src={chat.src} alt="ChitChat Logo" />
                <div>
                    <div class="text-xl font-medium text-black dark:text-white">Contáctanos</div>
                    <p class="text-gray-500 dark:text-gray-400">Reserva Ahora</p>
                </div>
            </div>
        </div>
    </div>
</section>