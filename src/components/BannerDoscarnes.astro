---
import "../styles/global.css";
---

<!-- Banner Dos Carnes -->
<section class="flex flex-wrap flex-col relative w-full bg-black">
    <div class="inset-0 justify-center items-center text-center p-20">
        <h1 class="font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">
            ¡Dos Carnes!
        </h1>
        <p class="font-poppins text-white text-lg md:text-2xl mb-8">
            Disfruta en Madrid de nuestras arepas, cachapas, empanadas, 
            tequeños y <br /> dulces tradicionales, hechos con amor y los sabores 
            auténticos de nuestra tierra.
        </p>
    </div>
</section>