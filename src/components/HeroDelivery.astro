---
import "../styles/global.css";
---

<!-- Hero Delivery -->
<section class="bg-stone-700 bg-[url(../img/hero/top_3.webp)] bg-no-repeat bg-cover bg-blend-overlay flex flex-wrap flex-col relative w-full">
    <div class="justify-center items-center text-center p-25">
        <h1 class="font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">
            Delivery
        </h1>
        <p class="font-poppins text-white text-lg md:text-2xl mb-8">
            Ofrecemos un servicio de delivery especializado para las zonas de <br />
            Valdebernardo y Vicálvaro, en Madrid, diseñado para <br /> brindar comodidad y
            calidad a los <br /> residentes de estas áreas.
        </p>
        <button class="font-poppins bg-black text-white hover:text-yellow-400 px-6 py-3 rounded-none border-yellow-400 border-4 font-medium text-2xl hover:bg-opacity-80 transition hover:-translate-y-1 hover:scale-110">
            Haz tu pedido
        </button>
    </div>
</section>