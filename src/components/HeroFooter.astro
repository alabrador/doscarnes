---
import "../styles/global.css";
---

<!-- Hero Footer -->
<section class="bg-stone-700 bg-[url(../img/hero/top_2.webp)] bg-no-repeat bg-cover bg-blend-overlay flex flex-wrap flex-col relative w-full">
    <div class="justify-center items-center text-center p-25">
        <h1 class="font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">
            Encarga tus hallacas
        </h1>
        <p class="font-poppins text-white text-lg md:text-2xl mb-8">
            Este año, en nuestro local, ya estamos tomando pedidos de las <br />
            tradicionales hallacas venezolanas. No dejes pasar la oportunidad 
            de <br /> disfrutar de este exquisito plato en <br /> familia o con amigos.
        </p>
        <!--<a href="/reservar"><button class="font-poppins bg-black text-white hover:text-yellow-400 px-6 py-3 rounded-none border-yellow-400 border-4 font-medium text-2xl hover:bg-opacity-80 transition hover:-translate-y-1 hover:scale-110">
            Reservar Ahora
        </button></a> -->
        <a href="/reservar"><button class="font-poppins shadow-sm shadow-yellow-500/50 bg-black text-white before:ease relative overflow-hidden px-6 py-3 border-yellow-400 border-4 font-medium text-2xl transition-all before:absolute before:top-1/2 before:h-0 before:w-64 before:origin-center before:-translate-x-10 before:rotate-45 before:bg-yellow-400 before:duration-300 hover:text-white hover:before:h-64 hover:before:-translate-y-32">
            <span class="relative z-10">Reservar Ahora</span>
        </button></a>
    </div>
</section>