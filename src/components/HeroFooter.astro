---
import hero from '../img/hero/top_2.webp';
import "../styles/global.css";
---
<section class="flex flex-wrap flex-col relative w-full">
    <img src={hero.src} alt="hero" />
    <div class="inset-0 absolute bg-black bg-opacity-80 justify-center items-center text-center p-20">
        <h1 class="font-righteous text-white text-4xl md:text-6xl font-bold mb-4">
            Encarga tus hallacas
        </h1>
        <p class="font-poppins text-white text-lg md:text-2xl mb-8">
            Este año, en nuestro local, ya estamos tomando pedidos de las <br />
            tradicionales hallacas venezolanas. No dejes pasar la oportunidad 
            de <br /> disfrutar de este exquisito plato en familia o con amigos.
        </p>
        <button class="font-poppins bg-black text-white px-6 py-3 rounded-none border-top border-4 font-medium text-2xl hover:bg-opacity-80 transition">
            Reservar Ahora
        </button>
    </div>
</section>