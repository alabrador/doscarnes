---
import logo from '../img/logo_doscarnes.webp';
import "../styles/global.css";
import { faFacebook, faXTwitter, faInstagram, faWhatsapp, faCcStripe, faCcVisa, faCcMastercard, faCcPaypal } from '@fortawesome/free-brands-svg-icons';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
---

<footer class="bg-black text-white py-5 border-t border-yellow-400">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- Logo y Mensaje -->
    <div class="flex flex-col items-center md:items-start">
      <img src={logo.src} alt="Dos Carnes" class="w-30 mb-2" />
      <p class="font-poppins text-center md:text-left text-sm">
        ¡Disfruta el auténtico sabor de Venezuela en cada bocado!
      </p>
    </div>

    <!-- Contacto -->
    <div class="font-poppins text-center md:text-left">
      <h3 class="text-yellow-400 font-bold text-lg mb-2">Contáctenos</h3>
      <ul class="space-y-2">
        <li class="flex items-center justify-center md:justify-start">
          <span class="mr-2">📧</span> pedidos@doscarnes.com
        </li>
        <li class="flex items-center justify-center md:justify-start">
          <span class="mr-2">📞</span> 678 3611 68
        </li>
        <li class="flex items-center justify-center md:justify-start">
          <span class="mr-2">📍</span> Avenida Real 17, 28032
        </li>
      </ul>
      <!-- Iconos Redes Sociales -->
      <div class="flex justify-center md:justify-start mt-3 space-x-3">
        <a href="https://facebook.com/doscarnes" target="_blank" class="box-content h-4 w-4 p-2 bg-yellow-400 text-black"><FontAwesomeIcon icon={faFacebook} /></a>
        <a href="https://x.com/doscarnes" target="_blank" class="box-content h-4 w-4 p-2 bg-yellow-400 text-black"><FontAwesomeIcon icon={faXTwitter} /></a>
        <a href="https://instagram.com/doscarnes" target="_blank" class="box-content h-4 w-4 p-2 bg-yellow-400 text-black"><FontAwesomeIcon icon={faInstagram} /></a>
        <a href="#" target="_blank" class="box-content h-4 w-4 p-2 bg-yellow-400 text-black"><FontAwesomeIcon icon={faWhatsapp} /></a>
      </div>
    </div>

    <!-- Enlaces -->
    <div class="font-poppins text-center md:text-left">
      <h3 class="text-yellow-400 font-bold text-lg mb-2">Enlaces</h3>
      <ul class="space-y-2">
        <li><a href="/lacarta" class="hover:text-yellow-400">📌 La carta</a></li>
        <li><a href="/reservar" class="hover:text-yellow-400">📌 Reservar pedido</a></li>
        <li><a href="/delivery" class="hover:text-yellow-400">📌 Delivery</a></li>
        <li><a href="/contacto" class="hover:text-yellow-400">📌 Contacto</a></li>
      </ul>
    </div>

    <!-- Métodos de Pago -->
    <div class="font-poppins text-center md:text-left">
      <h3 class="text-yellow-400 font-bold text-lg mb-2">Métodos de pago</h3>
      <div class="flex justify-center space-x-4">
        <FontAwesomeIcon icon={faCcStripe} />
        <FontAwesomeIcon icon={faCcVisa}  />
        <FontAwesomeIcon icon={faCcMastercard}  />
        <FontAwesomeIcon icon={faCcPaypal}  />
      </div>
    </div>
  </div>
</footer>

<!-- Derechos Reservados -->
<div class="bg-yellow-400 font-poppins font-bold text-center text-sm text-black py-4">
    © 2025 doscarnes.com - Todos los derechos reservados.
</div>