---
import arepas from '../img/products/arepas.webp';
import empanadas from '../img/products/empanadas.webp';
import tequenos from '../img/products/tequenos.webp';
import pastelitos from '../img/products/pastelitos.webp';
import cachapas from '../img/products/cachapas.webp';
import postres from '../img/products/tortas.webp';
import "../styles/global.css";
---
<section class="flex flex-wrap flex-col-3 bg-black">
<div class="bg-black w-fit mx-auto grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2 justify-items-center justify-center gap-y-0 gap-x-0 mt-0 mb-0">
    <div class="relative overflow-hidden bg-cover bg-no-repeat ">
        <img src={arepas.src} alt="Arepas" />
        <a href="https://pedidos.doscarnes.com/shop/category/arepas-1">
            <div class="justify-center items-center text-center absolute bottom-0 left-0 right-0 h-full w-full overflow-hidden bg-black bg-fixed opacity-0 transition duration-300 ease-in-out hover:opacity-100">
                <p class="absolute inset-0 flex items-center justify-center font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">Arepas</p>
            </div>
        </a>
    </div>
    <div class="relative overflow-hidden bg-cover bg-no-repeat">
        <img src={empanadas.src} alt="Empanadas" />
        <a href="https://pedidos.doscarnes.com/shop/category/empanadas-3">
            <div class="justify-center items-center text-center absolute bottom-0 left-0 right-0 h-full w-full overflow-hidden bg-black bg-fixed opacity-0 transition duration-300 ease-in-out hover:opacity-100">
                <p class="absolute inset-0 flex items-center justify-center font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">Empanadas</p>
            </div>
        </a>
    </div>
    <div class="relative overflow-hidden bg-cover bg-no-repeat">
        <img src={tequenos.src} alt="Tequeños" />
        <a href="https://pedidos.doscarnes.com/shop/category/tequenos-4">
            <div class="justify-center items-center text-center absolute bottom-0 left-0 right-0 h-full w-full overflow-hidden bg-black bg-fixed opacity-0 transition duration-300 ease-in-out hover:opacity-100">
                <p class="absolute inset-0 flex items-center justify-center font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">Tequeños</p>
            </div>
        </a>
    </div>
    <div class="relative overflow-hidden bg-cover bg-no-repeat">
        <img src={pastelitos.src} alt="Pastelitos" />
        <a href="https://pedidos.doscarnes.com/shop/category/pastelitos-5">
            <div class="justify-center items-center text-center absolute bottom-0 left-0 right-0 h-full w-full overflow-hidden bg-black bg-fixed opacity-0 transition duration-300 ease-in-out hover:opacity-100">
                <p class="absolute inset-0 flex items-center justify-center font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">Pastelitos</p>
            </div>
        </a>
    </div>
    <div class="relative overflow-hidden bg-cover bg-no-repeat">
        <img src={cachapas.src} alt="Cachapas" />
        <a href="https://pedidos.doscarnes.com/shop/category/cachapas-2">
            <div class="justify-center items-center text-center absolute bottom-0 left-0 right-0 h-full w-full overflow-hidden bg-black bg-fixed opacity-0 transition duration-300 ease-in-out hover:opacity-100">
                <p class="absolute inset-0 flex items-center justify-center font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">Cachapas</p>
            </div>
        </a>
    </div>
    <div class="relative overflow-hidden bg-cover bg-no-repeat">
        <img src={postres.src} alt="Postres" />
        <a href="https://pedidos.doscarnes.com/shop/category/tortas-6">
            <div class="justify-center items-center text-center absolute bottom-0 left-0 right-0 h-full w-full overflow-hidden bg-black bg-fixed opacity-0 transition duration-300 ease-in-out hover:opacity-100">
                <p class="absolute inset-0 flex items-center justify-center font-pacifico text-white text-4xl md:text-6xl font-normal mb-4">Tartas</p>
            </div>
        </a>
    </div>
</div>
</section>